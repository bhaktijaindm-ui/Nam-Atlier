{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/portfolio/:slug", "destination": "/portfolio-detail.html?project=:slug" },
    { "source": "/portfolio", "destination": "/portfolio-detail.html" },
    { "source": "/portfolio-detail", "destination": "/portfolio-detail.html" },
    { "source": "/services", "destination": "/service-detail.html" },
    { "source": "/service-detail", "destination": "/service-detail.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|mp4|woff2|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
